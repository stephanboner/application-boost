# ============================================================
# BewerbungsBoost – Umgebungsvariablen
# Kopiere diese Datei als .env.local und fülle alle Werte aus.
# NIEMALS .env.local in git committen!
# ============================================================

# --- Supabase ---
# Supabase Projekt-URL (aus Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Anon Key (öffentlich, für Client-side Auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (NUR server-side, NIEMALS im Frontend!)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API ---
# API Key von console.anthropic.com
ANTHROPIC_API_KEY=

# Claude Model (Sonnet für Qualität + Speed)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- App-Konfiguration ---
# URL der App (für Callbacks etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encryption Key für CV-Daten (32 Bytes, random hex)
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Rate Limiting
# Max. KI-Aufrufe pro Aktion und Stunde pro Nutzer
RATE_LIMIT_MAX_PER_HOUR=10

# Gemeinsames KI-Tageslimit (UTC); gilt für alle Konten und auch für Retries.
# Token-Reservierung: UTF-8-Promptbytes + 1024 Overhead + maximaler Output.
AI_MAX_CALLS_PER_DAY=100
AI_MAX_RESERVED_TOKENS_PER_DAY=500000

# --- E-Mail (optional, für Passwort-Reset) ---
# Supabase übernimmt standardmässig E-Mail-Versand via Auth
# Für eigene SMTP-Konfiguration in Supabase Dashboard konfigurieren
